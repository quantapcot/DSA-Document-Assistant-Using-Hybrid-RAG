# ============================================================
# DSA Study Assistant AI Agent — Backend Environment Variables
# Copy file này thành .env và điền giá trị thực tế.
# KHÔNG commit file .env thực vào Git.
# ============================================================

APP_NAME="DSA Study Assistant AI Agent"
ENV=development
HOST=0.0.0.0
PORT=8000

# ── Qdrant Vector DB ────────────────────────────────────────
QDRANT_URL=http://localhost:6333
# Khi chạy trong Docker Compose:
# QDRANT_URL=http://qdrant:6333

# ── Groq ──────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# ── Phiên học tạm (giây) ────────────────────────────────────
SESSION_TTL_SECONDS=28800
SESSION_CLEANUP_SECONDS=300

# Developer-only UTF-8 JSONL dumps of indexed chunks
EXPORT_DEBUG_CHUNKS=false
