# Copy to .env in this backend directory only if .env does not exist.
# Read by the existing app/core/config.py when launched from backend/.
APP_NAME="DSA Study Assistant AI Agent"
ENV=development
HOST=0.0.0.0
PORT=8000
OPENAI_API_KEY=
QDRANT_URL=http://localhost:6333
# When the backend eventually runs inside Docker Compose, the service address
# can be configured as: QDRANT_URL=http://qdrant:6333
