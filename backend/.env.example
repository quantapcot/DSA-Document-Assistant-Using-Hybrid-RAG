# ============================================================
# DSA Study Assistant AI Agent — Backend Environment Variables
# Copy file này thành .env và điền giá trị thực tế.
# KHÔNG commit file .env thực vào Git.
# ============================================================

APP_NAME="DSA Study Assistant AI Agent"
ENV=development
HOST=0.0.0.0
PORT=8000

# ── Qdrant Vector DB ────────────────────────────────────────
QDRANT_URL=http://localhost:6333
# Khi chạy trong Docker Compose:
# QDRANT_URL=http://qdrant:6333

# ── LLM Provider (C2 Generation) ───────────────────────────
# Chọn một trong hai: "gemini" hoặc "openai"
LLM_PROVIDER=openai

# Google Gemini (khuyến nghị — miễn phí có quota)
GEMINI_API_KEY=

# OpenAI-compatible (GPT-4o-mini, v.v.)
OPENAI_API_KEY=

# URL API OpenAI-compatible của FIT-AI (lấy ở mục "Get LLM API" của môn học)
LLM_BASE_URL=

# Tên model cụ thể (để trống = dùng default: gemini-2.0-flash / gpt-4o-mini)
LLM_MODEL=Qwen-27B
