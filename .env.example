# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN (TUẦN 4)
# ==========================================
# Sao chép file này thành .env ở thư mục gốc hoặc backend/.env để chạy ứng dụng:
# Copy-Item .env.example .env

# --- Cấu hình Backend (FastAPI) ---
APP_NAME="DSA Study Assistant AI Agent"
ENV=development
HOST=0.0.0.0
PORT=8000

# --- Cấu hình Frontend (Streamlit) ---
BACKEND_URL=http://127.0.0.1:8000

# --- Groq ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# --- Phiên học tạm (giây) ---
SESSION_TTL_SECONDS=28800
SESSION_CLEANUP_SECONDS=300

# --- Debug chunks export ---
EXPORT_DEBUG_CHUNKS=false

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
