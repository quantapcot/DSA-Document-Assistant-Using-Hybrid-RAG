# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN (TUẦN 4)
# ==========================================
# Sao chép file này thành .env ở thư mục gốc hoặc backend/.env để chạy ứng dụng:
# Copy-Item .env.example .env

# --- Cấu hình Backend (FastAPI) ---
APP_NAME="DSA Study Assistant AI Agent"
ENV=development
HOST=0.0.0.0
PORT=8000

# --- Cấu hình Frontend (Streamlit) ---
BACKEND_URL=http://127.0.0.1:8000

# --- Cấu hình Cơ sở dữ liệu & Dịch vụ ngoài (Dự kiến Tuần 5+) ---
OPENAI_API_KEY=
QDRANT_URL=http://localhost:6333
